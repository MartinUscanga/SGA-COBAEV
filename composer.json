{
    "name": "cobaev/sga-portal-padres",
    "description": "Sistema de Gestión de Asistencias - Portal de Padres COBAEV",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "google/auth": "^1.21"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
